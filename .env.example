# CASEPULSE Environment Configuration Template
# Copy this file to .env.local and update with your local values.

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://casepulse_app:your_password_here@127.0.0.1:55439/casepulse_dev"

# Authentication Secrets (Generate with `openssl rand -base64 32`)
AUTH_SECRET="your_auth_secret_minimum_32_characters"

# Development Demo Mode ('demo' enables mock authenticated profiles in development)
# In production, this fails closed automatically and requires real OIDC.
CASEPULSE_AUTH_MODE="demo"

# Production OIDC / SSO Configuration (Required if CASEPULSE_AUTH_MODE is not 'demo')
# AUTH_OIDC_ISSUER="https://auth.example.gov.in"
# AUTH_OIDC_CLIENT_ID="casepulse_client"
# AUTH_OIDC_CLIENT_SECRET="your_oidc_client_secret"
